# Copy to .env and fill in your own values. NEVER commit .env.

# --- Graph store (Neo4j, per ADR-0005) ---
# Local Docker (default): docker compose up -d
# URI/user/password must match docker-compose.yml (NEO4J_AUTH).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=taxonomies-dev

# Optional Aura (or remote): set URI to neo4j+s://… and credentials from the console.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# --- Vector index (provisional: pgvector — see ADR-0005) ---
# PGVECTOR_URL=

# --- Per-suite graph overrides ---
# A suite loader starts by DELETING that suite's nodes in whatever NEO4J_URI
# points at. These let one loader be pinned to its own instance without editing
# the shared variables every other suite reads. They fall back to NEO4J_* above.
# ONET_NEO4J_URI=bolt://localhost:7691
# ONET_NEO4J_USER=neo4j
# ONET_NEO4J_PASSWORD=
# ONET_NEO4J_DATABASE=neo4j
# BLS_NEO4J_URI=bolt://localhost:7694
# BLS_NEO4J_USER=neo4j
# BLS_NEO4J_PASSWORD=
# BLS_NEO4J_DATABASE=neo4j

# --- Taxonomy data sources (keys/paths per suite, as needed) ---
# Full ESCO English tables (local, gitignored under data/). Loader default if unset:
ESCO_DATA_DIR=data/esco/raw/DATABASE
# ESCO_API_BASE=
# Extracted O*NET text distribution (local, gitignored). Loader default if unset.
# Download needs no registration:
#   curl -O https://www.onetcenter.org/dl_files/database/db_30_3_text.zip
ONET_DATA_DIR=data/onet/raw/db_30_3_text
# ONET_API_KEY=   # only for the O*NET Web Services API; the bulk DB needs none
# SFIA_DATA_PATH=
# BLS: Employment Projections + OES occupation reference (local, gitignored).
# Loader default if unset. Downloads need no registration, but download.bls.gov
# expects an automated client to identify itself, so the fetcher refuses to run
# without a contact address:
#   export BLS_CONTACT="you@example.org"
#   python -m ta_taxonomies.suites.bls.fetch --out data/bls/raw
BLS_DATA_DIR=data/bls/raw
# BLS_CONTACT=
# ONET_API_KEY=
# SFIA: no public bulk download. Fetch a local snapshot under your OWN SFIA
# licence (python -m ta_taxonomies.suites.sfia.fetch); it stays gitignored and
# must never be committed — TA-workspace ADR-0006 §2.
# SFIA_DATA_DIR=data/sfia/raw
# Suite-scoped Neo4j override, so a wiping loader can be pinned to its own
# instance without editing the shared NEO4J_URI every suite reads.
# SFIA_NEO4J_URI=bolt://localhost:7695
# SFIA_NEO4J_PASSWORD=
# BLS_DATA_PATH=
